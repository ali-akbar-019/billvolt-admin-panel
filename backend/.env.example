# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# NEVER commit your real `.env` — it contains secrets.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/billvolt

# Redis (optional — Upstash recommended). App runs without it, but sessions
# can't be revoked early.
REDIS_URL=

# Auth — use long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string

# Field-level encryption (used for SSN and other sensitive Provider fields)
FIELD_ENCRYPTION_KEY=change_me_to_a_long_random_string

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional — used only by `npm run seed:admin`.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@billvolt.com
ADMIN_PASSWORD=Admin@12345

# Follow-up email notifications (nodemailer SMTP). If EMAIL_ENABLED isn't
# 'true' or the SMTP credentials are missing, emails are logged to the console
# instead of being sent — the app keeps working without them.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
